{
  "name": "apex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Apex: a raptor survival game about mastering your instincts.",
  "scripts": {
    "start": "node scripts/serve.mjs 4173",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/sim/*.test.js\"",
